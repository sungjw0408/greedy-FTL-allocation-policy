[global]
filename=${TEST_DEVICE}
ioengine=libaio
direct=1
time_based=1
runtime=120
ramp_time=30
randrepeat=1
randseed=20260923
group_reporting=1
thread=1
lat_percentiles=1
percentile_list=50:95:99:99.9:99.99
size=${TEST_SIZE}

[gc-writer]
rw=randwrite
bs=16k
numjobs=${WRITER_JOBS}
iodepth=${WRITER_QD}

[latency-probe]
new_group=1
rw=randread
bs=4k
numjobs=1
iodepth=1
rate_iops=${PROBE_IOPS}
